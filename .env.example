# 复制为 .env 并填入真实值；.env 不进 git
# LLM / VLM（DashScope，OpenAI 兼容入口）
DASHSCOPE_API_KEY=

# 粤语 TTS（二选一，阶段 2 ADR 定稿后启用对应项）
VOLC_TTS_APP_ID=
VOLC_TTS_TOKEN=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Milvus
MILVUS_URI=http://127.0.0.1:19530

# 嵌入模型（留空=自动从 HF 下载；建议指向本地目录以离线运行）
# BGE_M3_MODEL_PATH=models/hub-local/bge-m3
# CLIP_MODEL_PATH=models/hub-local/chinese-clip

# 检索服务（qwen3-rerank 等，本地部署地址）
RERANK_BASE_URL=

TTS_PROVIDER=dashscope
TTS_VOICE=longjiayi_v2

# 叙事链各阶段模型（story 重叙事用大档，insight 需视觉能力；review/narration 同档）
STORY_MODEL=qwen-max
NARRATION_MODEL=qwen-plus
REVIEW_MODEL=qwen-plus
INSIGHT_MODEL=qwen-vl-max
MAX_STORY_RETRY=1
