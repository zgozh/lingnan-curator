{
  "lines": [
    {
      "text": "老街巷口嘅大榕树下，阿婆嘅凉茶摊好热闹呀",
      "emotion": "温暖"
    },
    {
      "text": "佢坐住张小板凳，手摇蒲扇，笑眯眯望住过路人",
      "emotion": "怀念"
    },
    {
      "text": "细路围住佢讲学校趣事，阿婆听得好入神",
      "emotion": "温暖"
    },
    {
      "text": "凉茶香飘满条街，一杯落肚，暑气即刻散晒",
      "emotion": "温暖"
    },
    {
      "text": "阳光穿树叶落青石板，光点跳来跳去",
      "emotion": "平静"
    },
    {
      "text": "阿婆走咗，摊子仲喺度，静 quietly",
      "emotion": "低啲"
    },
    {
      "text": "但嗰份暖意，从来冇走远",
      "emotion": "感叹"
    }
  ]
}