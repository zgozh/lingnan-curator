{
  "lines": [
    {
      "text": "夕阳斜斜照落河畔嘅纪念碑上呀",
      "emotion": "温暖"
    },
    {
      "text": "老人家穿住长袍，静静站喺石阶顶",
      "emotion": "平静"
    },
    {
      "text": "望住远处泊紧嘅帆船，一动都唔动",
      "emotion": "怀念"
    },
    {
      "text": "手里捻住念珠，眼神有啲淡淡忧伤",
      "emotion": "感叹"
    },
    {
      "text": "风吹树叶沙沙响，好似讲紧旧故事",
      "emotion": "低啲"
    },
    {
      "text": "佢慢慢坐落石凳，深深噉吸一口气",
      "emotion": "温暖"
    },
    {
      "text": "嘴角轻轻一扬：‘罢了。’",
      "emotion": "平静"
    }
  ]
}