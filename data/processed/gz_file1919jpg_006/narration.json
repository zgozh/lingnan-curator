{
  "lines": [
    {
      "text": "嗰日阳光好正，十二个男人排晒喺草地呀。",
      "emotion": "温暖"
    },
    {
      "text": "西装同长衫都有，胸前白徽章随风轻轻摇。",
      "emotion": "平静"
    },
    {
      "text": "我站最左，手揸住礼帽，心扑通扑通跳。",
      "emotion": "平静"
    },
    {
      "text": "老李着住浅色长衫，话：‘今日呢刻，要记实啲。’",
      "emotion": "怀念"
    },
    {
      "text": "人人面都咁肃穆，好似话紧同一句心事。",
      "emotion": "平静"
    },
    {
      "text": "快门一响，时间好似停咗，连风都静晒。",
      "emotion": "感叹"
    },
    {
      "text": "佢拍下我肩膊，轻声讲：‘走啦。’",
      "emotion": "低啲"
    }
  ]
}