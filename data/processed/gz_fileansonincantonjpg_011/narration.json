{
  "lines": [
    {
      "text": "高台之上，中国官员端坐不动呀",
      "emotion": "平静"
    },
    {
      "text": "宽袖长袍、朝珠在颈，眼神好锐利",
      "emotion": "平静"
    },
    {
      "text": "欧洲使节白外套、三角帽，跪地行礼",
      "emotion": "怀念"
    },
    {
      "text": "随从跪坐低头，连呼吸都静咗",
      "emotion": "低啲"
    },
    {
      "text": "他轻轻抬手，示意大家起身",
      "emotion": "温暖"
    },
    {
      "text": "东西两边嘅心意，就喺呢刻接埋",
      "emotion": "感叹"
    },
    {
      "text": "目光望远，好似睇见将来嘅光",
      "emotion": "平静"
    }
  ]
}