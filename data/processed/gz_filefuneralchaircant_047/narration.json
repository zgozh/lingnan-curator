{
  "lines": [
    {
      "text": "罗道馆木门半开呀，斜阳照落青砖地。",
      "emotion": "怀念"
    },
    {
      "text": "竹轿静静躺喺度，好似等住个旧主人。",
      "emotion": "温暖"
    },
    {
      "text": "细个跟爷爷嚟呢度，听佢讲古、睇纸扎。",
      "emotion": "平静"
    },
    {
      "text": "而家佢走咗，馆仲喺度，连风都慢咗。",
      "emotion": "感叹"
    },
    {
      "text": "我摸下啲砖墙，'福祈'两个字仲清清楚楚。",
      "emotion": "温暖"
    },
    {
      "text": "转身要走，竹筒叮噹响，好似话：唔好走。",
      "emotion": "低啲"
    }
  ]
}