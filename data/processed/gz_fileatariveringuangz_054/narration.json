{
  "lines": [
    {
      "text": "石桥下河水慢悠悠呀，木船静静泊喺岸边。",
      "emotion": "平静"
    },
    {
      "text": "阿明戴住宽边帽，望住远方，一言不发。",
      "emotion": "怀念"
    },
    {
      "text": "船尾坐住个戴斗笠嘅人，两人冇讲半句。",
      "emotion": "低啲"
    },
    {
      "text": "佢仲记得，当年个穿旗袍嘅女仔笑得好甜。",
      "emotion": "温暖"
    },
    {
      "text": "铜钱仲喺袋度，人却再冇返嚟过。",
      "emotion": "感叹"
    },
    {
      "text": "桥上人来人往，河水照流，无声无息。",
      "emotion": "平静"
    },
    {
      "text": "阿明轻轻一撑篙，涟漪一圈圈散开……旧梦。",
      "emotion": "低啲"
    }
  ]
}