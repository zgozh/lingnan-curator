{
  "lines": [
    {
      "text": "钟楼指针停咗，午後阳光洒落青石板呀。",
      "emotion": "平静"
    },
    {
      "text": "拱门下嘅长衫同旗袍，影子拖得好长好静。",
      "emotion": "怀念"
    },
    {
      "text": "个女仔站喺台阶上，侧住头，好似听紧风声。",
      "emotion": "温暖"
    },
    {
      "text": "旗袍下摆轻轻扫过地，像旧日嘅一声轻叹。",
      "emotion": "感叹"
    },
    {
      "text": "周围人来人往，佢却好似活喺另一个年代。",
      "emotion": "低啲"
    },
    {
      "text": "眼尾有滴忧伤，唔係难过，係记挂。",
      "emotion": "怀念"
    },
    {
      "text": "叹口气转身走远，剩低一抹影，淡咗。",
      "emotion": "低啲"
    }
  ]
}